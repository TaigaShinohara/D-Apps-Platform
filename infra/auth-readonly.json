{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Review-only D-Apps IAM identity; no access keys, passwords, publishing or infrastructure write permissions.",
  "Resources": {
    "ReadOnlyUser": {
      "Type": "AWS::IAM::User",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserName": "DAppsReadOnly",
        "Tags": [{ "Key": "Project", "Value": "D-Apps" }],
        "Policies": [
          {
            "PolicyName": "DAppsPublicationReadiness",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "BrowserLoginOnThisDevice",
                  "Effect": "Allow",
                  "Action": [
                    "signin:AuthorizeOAuth2Access",
                    "signin:CreateOAuth2Token"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:signin:*:${AWS::AccountId}:oauth2/public-client/localhost"
                  }
                },
                {
                  "Sid": "InspectAccountDeliveryAndAuditConfiguration",
                  "Effect": "Allow",
                  "Action": [
                    "route53:ListHostedZonesByName",
                    "route53:GetHostedZone",
                    "route53:ListResourceRecordSets",
                    "cloudfront:ListDistributions",
                    "cloudfront:GetDistributionConfig",
                    "cloudtrail:DescribeTrails",
                    "cloudtrail:GetEventSelectors",
                    "cloudtrail:ListEventDataStores",
                    "cloudtrail:GetEventDataStore",
                    "logs:DescribeDeliverySources",
                    "logs:DescribeDeliveryDestinations",
                    "logs:DescribeDeliveries",
                    "wafv2:ListWebACLs",
                    "wafv2:GetWebACL",
                    "wafv2:GetLoggingConfiguration",
                    "wafv2:ListLoggingConfigurations",
                    "freetier:GetAccountPlanState",
                    "pricingplanmanager:GetSubscription",
                    "pricingplanmanager:ListSubscriptions",
                    "organizations:DescribeOrganization",
                    "ec2:DescribeRegions",
                    "iam:ListOpenIDConnectProviders"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "InspectGitHubOIDCProvider",
                  "Effect": "Allow",
                  "Action": "iam:GetOpenIDConnectProvider",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                  }
                },
                {
                  "Sid": "InspectOnlyDAppsBucketConfiguration",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLogging",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketPolicyStatus",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetEncryptionConfiguration"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::d-apps-*"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "UserName": { "Value": { "Ref": "ReadOnlyUser" } },
    "UserArn": { "Value": { "Fn::GetAtt": ["ReadOnlyUser", "Arn"] } }
  }
}
