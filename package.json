{
  "name": "d-apps-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/prepare-deployment.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "prepare:hosting": "node scripts/prepare-hosting.mjs",
    "verify:firebase": "node scripts/verify-firebase.mjs",
    "verify:distribution": "node scripts/verify-distribution-lock.mjs"
  },
  "dependencies": {
    "astro": "7.4.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "google-auth-library": "11.3.4",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "superstatic": "10.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
