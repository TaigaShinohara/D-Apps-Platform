---
import type { App, Locale } from '../lib/catalog';
import { categories } from '../lib/catalog';
import { distributionKindLabel } from '../lib/distribution';
import AppIcon from './AppIcon.astro';
interface Props {
  app: App;
  lang: Locale;
}
const { app, lang } = Astro.props;
const platforms = [...new Set(app.distributions.map((d) => d.platform))];
---

<article
  class="catalog-card"
  data-brand={app.id}
  data-app-card
  data-category={app.category}
  data-platforms={platforms.join(',')}
>
  <header class="catalog-card-heading">
    <AppIcon
      id={app.id}
      name={app.name}
      publicIcon={app.iconFallback ? undefined : `/media/${app.id}-icon.png`}
      fallback={app.iconFallback}
    />
    <div>
      <p class="eyebrow">{categories[app.category][lang]}</p>
      <h3>
        <a href={`/${lang}/apps/${app.id}/`}>{app.name}</a>
      </h3>
    </div>
  </header>
  <div class="catalog-card-body">
    <p class="card-summary">{app.summary[lang]}</p>
    <p class="card-meta">
      {platforms.join(' / ')}
      <span aria-hidden="true"> · </span>
      {app.price[lang]}
      <span aria-hidden="true"> · </span>
      {[
        ...new Set(
          app.distributions.map((item) => distributionKindLabel(item, lang)),
        ),
      ].join(' / ')}
    </p>
    <a class="text-link" href={`/${lang}/apps/${app.id}/`}>
      {lang === 'ja' ? '詳しく見る' : 'Explore'}
      <span class="sr-only"> {app.name}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
