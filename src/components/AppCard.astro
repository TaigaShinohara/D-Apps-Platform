---
import type { App, Locale } from '../lib/catalog';
import { categories } from '../lib/catalog';
import { distributionKindLabel } from '../lib/distribution';
import AppVisual from './AppVisual.astro';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const platforms = [...new Set(app.distributions.map((item) => item.platform))];
const sources = [
  ...new Set(
    app.distributions.map((item) => distributionKindLabel(item, lang)),
  ),
];
---

<article
  class="catalog-card"
  data-brand={app.id}
  data-app-card
  data-category={app.category}
  data-platforms={platforms.join(',')}
>
  <div class="catalog-card-visual">
    <AppVisual
      id={app.id}
      name={app.name}
      lang={lang}
      compact
      publicIcon={app.iconFallback ? undefined : `/media/${app.id}-icon.png`}
      fallback={app.iconFallback}
    />
  </div>
  <div class="catalog-card-body">
    <p class="card-meta">
      {[categories[app.category][lang], ...platforms].join(' · ')}
    </p>
    <h3>
      <a class="catalog-card-link" href={`/${lang}/apps/${app.id}/`}>
        {app.name}
      </a>
    </h3>
    <p class="card-summary">{app.summary[lang]}</p>
    <p class="card-meta catalog-card-status">
      {[app.price[lang], ...sources].join(' · ')}
    </p>
  </div>
</article>
