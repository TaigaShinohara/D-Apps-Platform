---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  name: string;
  publicIcon?: string;
  fallback?: string;
}

const icons = import.meta.glob<ImageMetadata>('../assets/catalog-icons/*.png', {
  eager: true,
  import: 'default',
});
const { id, name, publicIcon, fallback } = Astro.props;
const icon = fallback ? undefined : icons[`../assets/catalog-icons/${id}.png`];
---

<span class="catalog-icon" aria-hidden="true">
  {icon ? (
    <Image
      src={icon}
      width={Math.min(320, icon.width)}
      height={Math.min(320, icon.height)}
      format="webp"
      alt=""
      loading="lazy"
    />
  ) : publicIcon ? (
    <img src={publicIcon} width="64" height="64" alt="" loading="lazy" />
  ) : (
    <span>{fallback ?? [...name][0]}</span>
  )}
</span>
