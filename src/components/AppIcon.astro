---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { appArtwork } from '../data/app-artwork';

interface Props {
  id: string;
  name: string;
  publicIcon?: string;
  fallback?: string;
}

const icons = import.meta.glob<ImageMetadata>('../assets/catalog-icons/*.png', {
  eager: true,
  import: 'default',
});
const { id, name, publicIcon, fallback } = Astro.props;
const artwork = appArtwork[id];
const icon =
  icons[`../assets/catalog-icons/${id}.png`] ??
  (artwork?.kind === 'mark' ? artwork.image : undefined);
---

<span class="catalog-icon" aria-hidden="true">
  {icon ? (
    <Image
      src={icon}
      width={144}
      height={144}
      format="webp"
      alt=""
      loading="lazy"
    />
  ) : publicIcon ? (
    <img src={publicIcon} width="64" height="64" alt="" loading="lazy" />
  ) : (
    <span>{fallback ?? [...name][0]}</span>
  )}
</span>
