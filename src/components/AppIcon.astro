---
import type { App } from '../lib/catalog';

interface Props {
  app: App;
}

const { app } = Astro.props;
---

{app.iconFallback ? (
  <span class="app-icon app-icon-fallback" aria-hidden="true">
    {app.iconFallback}
  </span>
) : (
  <img
    class="app-icon"
    src={`/media/${app.id}-icon.png`}
    width="80"
    height="80"
    alt=""
    loading="lazy"
  />
)}
