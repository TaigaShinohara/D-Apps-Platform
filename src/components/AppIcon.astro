---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  name: string;
  publicIcon?: string;
  fallback?: string;
  compact?: boolean;
}

const icons = import.meta.glob<ImageMetadata>('../assets/catalog-icons/*.png', {
  eager: true,
  import: 'default',
});
const { id, name, publicIcon, fallback, compact } = Astro.props;
const icon = fallback ? undefined : icons[`../assets/catalog-icons/${id}.png`];
const responsiveWidths =
  icon && icon.width >= 512 ? [128, 256, 512] : undefined;
---

<span class="catalog-icon" aria-hidden="true">
  {icon ? (
    <Image
      src={icon}
      width={Math.min(512, icon.width)}
      height={Math.min(512, icon.height)}
      widths={responsiveWidths}
      sizes={responsiveWidths ? (compact ? '116px' : '206px') : undefined}
      format="webp"
      alt=""
      loading="lazy"
    />
  ) : publicIcon ? (
    <img src={publicIcon} width="64" height="64" alt="" loading="lazy" />
  ) : (
    <span>{fallback ?? [...name][0]}</span>
  )}
</span>
