---
import {
  projectStatus,
  type ProjectEntry,
  type SkillEntry,
} from '../data/showcase';
import type { Locale } from '../lib/catalog';
import AppVisual from './AppVisual.astro';

interface Props {
  id: 'projects' | 'skills';
  title: string;
  items: readonly (SkillEntry | ProjectEntry)[];
  lang: Locale;
}

const { id, title, items, lang } = Astro.props;
const ja = lang === 'ja';
---

<section id={id} class="showcase wrap" aria-labelledby={`${id}-heading`}>
  <div class="section-heading">
    <h2 id={`${id}-heading`}>{title}</h2>
  </div>
  <div class:list={['app-grid', { 'skill-grid': id === 'skills' }]}>
    {items.map((item) => {
      const project = 'id' in item;
      const brand = project ? item.id : item.repository;
      return (
        <article class="catalog-card" data-brand={brand}>
          <div class="catalog-card-visual">
            <AppVisual id={brand} name={item.name} lang={lang} compact />
          </div>
          <div class="catalog-card-body">
            {project && item.platform && (
              <p class="card-meta">{item.platform}</p>
            )}
            <h3>
              <a class="catalog-card-link" href={`/${lang}/${id}/${brand}/`}>
                {item.name}
              </a>
            </h3>
            <p class="card-summary">{item.summary[lang]}</p>
            {project && (
              <p class="card-meta catalog-card-status">
                {projectStatus(item, lang)}
              </p>
            )}
            {item.repository && (
              <a
                class="catalog-source"
                href={`https://github.com/TaigaShinohara/${item.repository}`}
                rel="noopener noreferrer"
              >
                {ja ? 'GitHubで見る' : 'View on GitHub'}
                <span class="sr-only"> {item.name}</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>
