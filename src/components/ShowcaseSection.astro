---
import {
  projectStatus,
  type ProjectEntry,
  type SkillEntry,
} from '../data/showcase';
import type { Locale } from '../lib/catalog';
import AppIcon from './AppIcon.astro';

interface Props {
  id: 'projects' | 'skills';
  title: string;
  items: readonly (SkillEntry | ProjectEntry)[];
  lang: Locale;
}

const { id, title, items, lang } = Astro.props;
const ja = lang === 'ja';
---

<section id={id} class="showcase wrap" aria-labelledby={`${id}-heading`}>
  <div class="section-heading">
    <h2 id={`${id}-heading`}>{title}</h2>
  </div>
  <div class="app-grid">
    {items.map((item) => {
      const brand = 'id' in item ? item.id : item.repository;
      return (
        <article class="catalog-card" data-brand={brand}>
          <header class="catalog-card-heading">
            <AppIcon id={brand} name={item.name} />
            <h3>
              {'id' in item ? (
                <a href={`/${lang}/projects/${item.id}/`}>{item.name}</a>
              ) : (
                item.name
              )}
            </h3>
          </header>
          <div class="catalog-card-body">
            {'id' in item && (
              <p class="card-meta">
                {item.platform && `${item.platform} · `}
                {projectStatus(item, lang)}
              </p>
            )}
            <p class="card-summary">{item.summary[lang]}</p>
            {item.members && (
              <p class="card-meta">{item.members.join(' · ')}</p>
            )}
            {item.repository && (
              <a
                class="text-link"
                href={`https://github.com/TaigaShinohara/${item.repository}`}
                rel="noopener noreferrer"
              >
                {ja ? 'GitHubで見る' : 'View on GitHub'}
                <span class="sr-only"> {item.name}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>
  <slot />
</section>
