---
import Layout from '../../layouts/Layout.astro';
import AppCard from '../../components/AppCard.astro';
import ShowcaseSection from '../../components/ShowcaseSection.astro';
import { projects, skills } from '../../data/showcase';
import { apps, locales, categories, type Locale } from '../../lib/catalog';
import { scriptIntegrity } from '../../lib/security.mjs';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ja = lang === 'ja';
const filters = apps.length >= 6;
const categoryKeys = [...new Set(apps.map((app) => app.category))];
const platforms = [
  ...new Set(
    apps.flatMap((app) => app.distributions.map((item) => item.platform)),
  ),
];
---

<Layout
  lang={lang}
  title={
    ja ? '毎日に、ちょうどいいアプリを。' : 'Good tools for everyday things.'
  }
  description={
    ja
      ? '小さなひと手間を、少し心地よく。D-Appsは、つくったアプリを用途と配布情報とともに紹介する場所です。'
      : 'Thoughtful apps for everyday tasks. Explore what they do, how they work, and where to download them.'
  }
>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow hero-label">
        <span class="small-line" aria-hidden="true"></span>
        {ja
          ? '小さな工夫から、生まれたアプリ。'
          : 'INDEPENDENT APPS. EVERYDAY POSSIBILITIES.'}
      </p>
      <h1 id="content" tabindex="-1">
        {ja ? (
          <>
            毎日に、
            <br />
            <span class="ink-blue">ちょうどいい</span>
            <br />
            アプリを。
          </>
        ) : (
          <>
            Good tools.
            <br />
            <span class="ink-blue">Everyday</span>
            <br />
            possibilities.
          </>
        )}
      </h1>
      <p class="hero-description">
        {ja ? (
          <>
            小さなひと手間を、少し心地よく。
            <br />
            つくったアプリを、ここからお届けします。
          </>
        ) : (
          <>
            A little less friction. A little more possibility.
            <br />
            Discover thoughtfully made apps, right here.
          </>
        )}
      </p>
      <a class="button" href="#apps">
        {ja ? 'アプリを見つける' : 'Explore the apps'}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-grid"></div>
      <span class="visual-label">MADE FOR YOUR EVERYDAY</span>
      <div class="floating-note note-back">
        <span class="mini-bar"></span>
        <span class="note-line"></span>
        <span class="note-line short"></span>
      </div>
      <div class="floating-note note-front">
        <img
          src="/media/oneclip-icon.png"
          width="106"
          height="106"
          alt=""
          fetchpriority="high"
        />
        <strong>OneClip</strong>
        <span>Capture. Collect. Share.</span>
        <div class="preview-lines">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="visual-check">✓</div>
      </div>
      <span class="visual-caption">LESS FRICTION, MORE FLOW.</span>
      <span class="visual-corner">01 — MACOS</span>
    </div>
  </section>
  <div class="principles wrap">
    <p>
      <span aria-hidden="true">◎</span>
      {ja ? '登録なしで、すぐに。' : 'No sign-up. Just apps.'}
    </p>
    <p>
      <span aria-hidden="true">↗</span>
      {ja ? '配布元を、わかりやすく。' : 'Clear download sources.'}
    </p>
    <p>
      <span aria-hidden="true">◇</span>
      {ja ? '行動の追跡はしません。' : 'No behavioral tracking.'}
    </p>
  </div>
  <section id="apps" class="catalog wrap">
    <div class="section-heading">
      <h2>{ja ? '配布中のアプリ' : 'Available apps'}</h2>
      <p>
        {String(apps.length).padStart(2, '0')}{' '}
        {ja ? 'アプリ' : 'APP' + (apps.length === 1 ? '' : 'S')}
      </p>
    </div>
    {filters && (
      <>
        <div class="filters" data-filters hidden>
          <label for="category">
            {ja ? 'カテゴリ' : 'Category'}
            <select id="category" data-category>
              <option value="">{ja ? 'すべて' : 'All'}</option>
              {categoryKeys.map((key) => (
                <option value={key}>{categories[key][lang]}</option>
              ))}
            </select>
          </label>
          <label for="platform">
            {ja ? '対応OS' : 'Platform'}
            <select id="platform" data-platform>
              <option value="">{ja ? 'すべて' : 'All'}</option>
              {platforms.map((platform) => (
                <option value={platform}>{platform}</option>
              ))}
            </select>
          </label>
        </div>
        <p data-result-status role="status" aria-live="polite"></p>
        <script
          is:inline
          src="/scripts/filter.js"
          integrity={scriptIntegrity}
          defer
        ></script>
      </>
    )}
    <div class="app-grid">
      {apps.map((app) => (
        <AppCard app={app} lang={lang} />
      ))}
    </div>
  </section>
  <ShowcaseSection
    id="projects"
    title={
      ja ? '開発中・過去のアプリ' : 'Apps in development and past projects'
    }
    items={projects}
    lang={lang}
  />
  <ShowcaseSection
    id="skills"
    title={ja ? 'AIエージェント向けスキル' : 'Skills for AI agents'}
    items={skills}
    lang={lang}
  >
    <a
      class="text-link showcase-more"
      href="https://github.com/TaigaShinohara/skills-updater"
      rel="noopener noreferrer"
    >
      {ja ? 'スキルのインストール・更新ツール' : 'Skill installer and updater'}
      <span aria-hidden="true">↗</span>
    </a>
  </ShowcaseSection>
  <section class="promise wrap">
    <div class="promise-symbol" aria-hidden="true">
      d.
    </div>
    <div>
      <p class="eyebrow" lang="en">
        OPEN BY DESIGN
      </p>
      <h2>
        {ja
          ? '使う前から、わかることを大切に。'
          : 'Clarity comes before the download.'}
      </h2>
      <p>
        {ja
          ? 'どんなアプリか。どこから届くか。データをどう扱うか。安心して選べるよう、一つひとつお伝えします。'
          : 'What an app does. Where it comes from. How it handles your data. We put that information where you can find it.'}
      </p>
      <a class="text-link" href={`/${lang}/about/`}>
        {ja ? 'D-Appsについて' : 'About D-Apps'}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
