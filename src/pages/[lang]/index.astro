---
import { Image } from 'astro:assets';
import AppVisual from '../../components/AppVisual.astro';
import tankArtwork from '../../assets/wavarium/tank.webp';
import Layout from '../../layouts/Layout.astro';
import AppCard from '../../components/AppCard.astro';
import ShowcaseSection from '../../components/ShowcaseSection.astro';
import { projects, skills } from '../../data/showcase';
import { apps, locales, categories, type Locale } from '../../lib/catalog';
import { scriptIntegrity } from '../../lib/security.mjs';
import '../../styles/app-artwork.css';
import '../../styles/catalog-cards.css';
import '../../styles/home-showcase.css';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ja = lang === 'ja';
const filters = apps.length >= 6;
const categoryKeys = [...new Set(apps.map((app) => app.category))];
const platforms = [
  ...new Set(
    apps.flatMap((app) => app.distributions.map((item) => item.platform)),
  ),
];
---

<Layout
  lang={lang}
  title={ja ? '毎日を、少し楽しく。' : 'Small apps. More ways to play.'}
  description={
    ja
      ? '小さなひと手間を、少し心地よく。D-Appsは、つくったアプリを用途と配布情報とともに紹介する場所です。'
      : 'Thoughtful apps for everyday tasks. Explore what they do, how they work, and where to download them.'
  }
>
  <div class="studio-home">
    <section class="studio-hero wrap">
      <div class="studio-intro">
        <h1 id="content" tabindex="-1">
          {ja ? (
            <>
              毎日を、
              <br />
              <span>少し楽しく。</span>
            </>
          ) : (
            <>
              Small apps.
              <br />
              <span>More ways</span> to play.
            </>
          )}
        </h1>
        <p>
          {ja
            ? '撮る、つくる、ひと息つく。日々の小さな工夫から生まれたアプリと、いま育てている作品を集めました。'
            : 'Capture something, make something, or take a breath. Explore apps born from small everyday ideas and projects still taking shape.'}
        </p>
        <div class="studio-actions">
          <a class="button" href="#apps">
            {ja ? 'アプリを探す' : 'Explore apps'}{' '}
            <span aria-hidden="true">↓</span>
          </a>
          <a class="text-link" href="#projects">
            {ja ? '制作中の作品' : 'See the projects'}{' '}
            <span aria-hidden="true">↘</span>
          </a>
        </div>
      </div>

      <div class="studio-gallery">
        <a
          class="studio-tile studio-tile-editor"
          data-brand="open-screenshot-generator"
          href={`/${lang}/projects/open-screenshot-generator/`}
        >
          <AppVisual
            id="open-screenshot-generator"
            name="tiger screen shot"
            lang={lang}
            compact
            priority
          />
          <span>
            tiger screen shot <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a
          class="studio-tile"
          data-brand="omamori-pet"
          href={`/${lang}/projects/omamori-pet/`}
        >
          <AppVisual id="omamori-pet" name="お守りペット" lang={lang} compact />
          <span>
            {ja ? 'お守りペット' : 'Omamori Pet'}{' '}
            <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a
          class="studio-tile"
          data-brand="yoriai"
          href={`/${lang}/apps/yoriai/`}
        >
          <AppVisual id="yoriai" name="yoriAI" lang={lang} compact />
          <span>
            yoriAI <span aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
    </section>
    <section id="apps" class="catalog wrap">
      <div class="section-heading">
        <h2>{ja ? '配布中のアプリ' : 'Available apps'}</h2>
        <p>
          {apps.length} {ja ? 'アプリ' : 'APP' + (apps.length === 1 ? '' : 'S')}
        </p>
      </div>
      {filters && (
        <>
          <div class="filters" data-filters hidden>
            <label for="category">
              {ja ? 'カテゴリ' : 'Category'}
              <select id="category" data-category>
                <option value="">{ja ? 'すべて' : 'All'}</option>
                {categoryKeys.map((key) => (
                  <option value={key}>{categories[key][lang]}</option>
                ))}
              </select>
            </label>
            <label for="platform">
              {ja ? '対応OS' : 'Platform'}
              <select id="platform" data-platform>
                <option value="">{ja ? 'すべて' : 'All'}</option>
                {platforms.map((platform) => (
                  <option value={platform}>{platform}</option>
                ))}
              </select>
            </label>
          </div>
          <p data-result-status role="status" aria-live="polite"></p>
          <script
            is:inline
            src="/scripts/filter.js"
            integrity={scriptIntegrity}
            defer
          ></script>
        </>
      )}
      <div class="app-grid">
        {apps.map((app) => (
          <AppCard app={app} lang={lang} />
        ))}
      </div>
    </section>
    <ShowcaseSection
      id="projects"
      title={
        ja ? '開発中・過去のアプリ' : 'Apps in development and past projects'
      }
      items={projects}
      lang={lang}
    />
    <section class="showcase wrap" aria-labelledby="music-heading">
      <div class="section-heading">
        <h2 id="music-heading">{ja ? '音楽プロジェクト' : 'Music project'}</h2>
      </div>
      <article class="music-feature">
        <div class="music-feature-copy">
          <h3>
            <a href="/wavarium/" hreflang="ja">
              {ja ? 'WAV/ARIUM' : 'WAV/ARIUM (Japanese)'}
            </a>
          </h3>
          <p class="card-summary">
            {ja
              ? '水槽から、デビューへ。音楽集団 WAV/ARIUM の音が形になるまでの制作日誌。'
              : 'From the tank to the stage. Follow the music collective WAV/ARIUM as their sound takes shape.'}
          </p>
        </div>
        <Image
          src={tankArtwork}
          widths={[480, 800]}
          width={800}
          sizes="(max-width: 680px) 90vw, 650px"
          alt=""
          loading="lazy"
        />
      </article>
    </section>
    <ShowcaseSection
      id="skills"
      title={ja ? 'AIエージェント向けスキル' : 'Skills for AI agents'}
      items={skills}
      lang={lang}
    />
    <section class="promise wrap">
      <div class="promise-symbol" aria-hidden="true">
        d.
      </div>
      <div>
        <h2>
          {ja
            ? '使う前から、わかることを大切に。'
            : 'Clarity comes before the download.'}
        </h2>
        <p>
          {ja
            ? 'どんなアプリか。どこから届くか。データをどう扱うか。安心して選べるよう、一つひとつお伝えします。'
            : 'What an app does. Where it comes from. How it handles your data. We put that information where you can find it.'}
        </p>
        <a class="text-link" href={`/${lang}/about/`}>
          {ja ? 'D-Appsについて' : 'About D-Apps'}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
