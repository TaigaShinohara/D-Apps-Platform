---
import Layout from '../../../layouts/Layout.astro';
import AppHero from '../../../components/AppHero.astro';
import DownloadLink from '../../../components/DownloadLink.astro';
import {
  appDetails,
  locales,
  categories,
  type App,
  type Locale,
} from '../../../lib/catalog';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    appDetails.map((app) => ({ params: { lang, id: app.id }, props: { app } })),
  );
}
const { app } = Astro.props as { app: App };
const lang = Astro.params.lang as Locale;
const ja = lang === 'ja';
const hasDirectDownload = app.distributions.some(
  (item) => item.kind === 'direct',
);
const hasPreview = app.distributions.some(
  (item) => item.kind === 'github-preview',
);
---

<Layout
  lang={lang}
  title={`${app.name} — ${app.summary[lang]}`}
  description={app.description[lang]}
  path={`apps/${app.id}/`}
>
  <div class="wrap detail">
    <a class="back-link" href={`/${lang}/#apps`}>
      ← {ja ? 'アプリ一覧' : 'All apps'}
    </a>
    <AppHero
      id={app.id}
      name={app.name}
      meta={[
        categories[app.category][lang],
        ...new Set(app.distributions.map((item) => item.platform)),
        ...(hasPreview ? [ja ? 'プレビュー版' : 'Preview'] : []),
      ].join(' · ')}
      intro={app.tagline[lang]}
      lang={lang}
      getLabel={
        app.distributions.length > 0
          ? ja
            ? '入手方法を見る'
            : 'See how to get it'
          : undefined
      }
    />
    {app.distributions.length === 0 && (
      <p>
        {ja
          ? '現在、このアプリの配布を停止しています。'
          : 'Distribution of this app is currently stopped.'}
      </p>
    )}
    <div class="detail-columns">
      <div class="detail-content">
        <p class="lead">{app.description[lang]}</p>
        <ul class="feature-list" role="list">
          {app.features.map((feature) => (
            <li>
              <span aria-hidden="true">✓</span>
              {feature[lang]}
            </li>
          ))}
        </ul>
        <section class="detail-section">
          <h2>{ja ? '使い始めるには' : 'Getting started'}</h2>
          <ol class="steps">
            {app.instructions.map((step) => (
              <li>{step[lang]}</li>
            ))}
          </ol>
        </section>
        <section class="detail-section">
          <h2>{ja ? '権限とデータの扱い' : 'Permissions and your data'}</h2>
          <h3>{ja ? '必要な権限' : 'Required permission'}</h3>
          <p>{app.permissions[lang]}</p>
          <h3>{ja ? '保存と通信' : 'Storage and connections'}</h3>
          <p>{app.privacy[lang]}</p>
        </section>
        <section class="detail-section">
          <h2>{ja ? '知っておいてほしいこと' : 'Before you install'}</h2>
          <p>{app.limitations[lang]}</p>
          {hasDirectDownload && (
            <p>
              {ja
                ? '署名と公証は配布元を確認する手がかりであり、すべての不具合や危険がないことを保証するものではありません。'
                : 'Signing and notarization help verify the publisher. They do not guarantee that software is free of every defect or risk.'}
            </p>
          )}
        </section>
      </div>
      <aside
        id="get-app"
        tabindex="-1"
        class="download-panel"
        aria-label={ja ? `${app.name}の配布情報` : `Where to get ${app.name}`}
      >
        <h2>{ja ? '入手する' : 'Get the app'}</h2>
        <p>{app.price[lang]}</p>
        <dl>
          <dt>{ja ? '対応環境' : 'Requirements'}</dt>
          <dd>{app.requirements[lang]}</dd>
          <dt>{ja ? '情報更新日' : 'Listing updated'}</dt>
          <dd>
            <time datetime={app.updated}>{app.updated}</time>
          </dd>
        </dl>
        {app.distributions.map((item) => (
          <div class="download-option">
            <DownloadLink app={app} item={item} lang={lang} />
            {item.kind === 'direct' && (
              <>
                <p class="download-meta">
                  v{item.version} ·{' '}
                  {item.filename.split('.').at(-1)?.toUpperCase()} ·{' '}
                  {(item.bytes / 1_000_000).toFixed(2)} MB
                </p>
                <p class="download-origin">
                  {ja
                    ? 'このサイトから直接ダウンロード'
                    : 'Direct download from this site'}
                </p>
                <dl>
                  <dt>{ja ? '署名・公証' : 'Signing & notarization'}</dt>
                  <dd>{item.verification.signing}</dd>
                </dl>
                <details>
                  <summary>
                    {ja ? 'ファイルの照合情報' : 'Verify the file'}
                  </summary>
                  <p>SHA-256</p>
                  <code class="hash">{item.sha256}</code>
                  <p>{item.bytes.toLocaleString('en-US')} bytes</p>
                  <a
                    href={item.verification.evidence}
                    rel="noopener noreferrer"
                  >
                    {ja ? '公開元の検証記録' : 'Publisher verification notes'} ↗
                  </a>
                </details>
                <a
                  class="external-link"
                  href={item.releaseUrl}
                  rel="noopener noreferrer"
                >
                  {ja
                    ? '更新履歴・元の配布ページ'
                    : 'Release notes & original download'}{' '}
                  ↗
                </a>
              </>
            )}
          </div>
        ))}
        {app.sourceUrl && (
          <a
            class="external-link"
            href={app.sourceUrl}
            rel="noopener noreferrer"
          >
            {ja ? 'アプリのソースコード' : 'App source code'} ↗
          </a>
        )}
        {app.supportUrl && (
          <a
            class="external-link"
            href={app.supportUrl}
            rel="noopener noreferrer"
          >
            {ja ? 'サポートを見る' : 'Get support'} ↗
          </a>
        )}
        <p class="fine-print">
          {ja
            ? '外部サイトには、それぞれのプライバシー方針が適用されます。'
            : 'External sites have their own privacy policies.'}
        </p>
      </aside>
    </div>
  </div>
</Layout>
